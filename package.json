{
  "name": "lightwood-home-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "test:panorama": "node tests/panorama.mjs",
    "test:rooms": "node tests/room-views.mjs",
    "test:quality": "node tests/panorama-quality.mjs",
    "planc:setup": "python3 planC/scripts/bootstrap.py",
    "planc:api": "planC/.venv/bin/python -m archviz.cli serve",
    "planc:validate": "planC/.venv/bin/python -m archviz.cli validate",
    "planc:render": "planC/.venv/bin/python planC/scripts/render_demo.py --rooms living dining master guest study kitchen bathroom --panorama --still-profile preview_fast",
    "planc:render:hd": "planC/.venv/bin/python planC/scripts/render_demo.py --rooms living --panorama --high-resolution",
    "planc:export": "planC/.venv/bin/python planC/scripts/export_site.py",
    "test:planc": "planC/.venv/bin/python -m pytest planC/tests -q",
    "test:planc:browser": "node tests/plan-c.mjs"
  },
  "dependencies": {
    "lucide": "^1.57.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
